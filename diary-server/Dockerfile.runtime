# =============================================================================
#  diary-server · 运行时镜像(jar 已在宿主机构建好)
#
#  与 Dockerfile 的区别:不装 maven、不在容器里编译,只把现成的 jar 塞进 jre 镜像。
#  适合"宿主机已经装好 JDK 17 + Maven"的情况,省掉拉 maven 镜像(约 500MB)
#  和容器内下载依赖的时间。
#
#  前置:在 diary-server 目录先执行
#    mvn -s settings.xml -DskipTests clean package
# =============================================================================
FROM eclipse-temurin:17-jre

RUN useradd --system --create-home --uid 10001 diary \
    && mkdir -p /data/uploads \
    && chown -R diary:diary /data

WORKDIR /app
COPY target/diary-server-*.jar app.jar

ENV TZ=Asia/Shanghai \
    UPLOAD_DIR=/data/uploads \
    JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=75 -Dfile.encoding=UTF-8"

USER diary
EXPOSE 8082

ENTRYPOINT ["java", "-jar", "/app/app.jar"]
