# =============================================================================
#  diary-web · 运行时镜像(dist 已在宿主机构建好)
#
#  与 Dockerfile 的区别:不装 node、不跑 vite build,只把现成的 dist 拷进 nginx。
#
#  前置:在 diary-web 目录先执行
#    npm ci && npm run build
#
#  注意:.dockerignore 里必须放行 dist/(已放行),否则 COPY 拿不到东西,
#  报错是 "COPY failed: no source files were specified",看不出是 .dockerignore 干的。
# =============================================================================
FROM nginx:1.27-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY dist /usr/share/nginx/html

EXPOSE 80
