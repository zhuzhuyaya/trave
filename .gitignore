# 构建产物不入库 —— 源项目没有 .gitignore(它没把构建目录放进版本管理),
# 但这个仓库要在本机构建与测试,不挡住 target/ 与 node_modules/ 的话,
# 每次修改源码再提交都会把一堆 .class 与依赖拖进历史。
diary-server/target/
diary-server/uploads/
diary-server/tile-cache/
diary-web/node_modules/
diary-web/dist/

.idea/
*.iml

# Playwright 调试产物
.playwright-mcp/

# html2video 渲染工具的本地依赖、浏览器链接与渲染产物
tools/html2video/node_modules/
tools/html2video/.browsers/
tools/html2video/out/
tools/html2video/sample/.tmp-h2v-*.html

# geo-build 的原始上游数据(3.5MB,按 tools/geo-build/README.md 里的 curl 命令重下)
# 只把生成产物 tools/geo-build/out/ 入库,原始数据不进历史
tools/geo-build/geo-data/
